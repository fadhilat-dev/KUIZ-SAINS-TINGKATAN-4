```yaml
name: Update Code List

on:
  push:
    branches:
      - "**"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-code-list:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          ref: ${{ github.ref }}

      - name: Generate code list
        env:
          GH_REPOSITORY: ${{ github.repository }}
          GH_BRANCH: ${{ github.ref_name }}
        run: |
          python3 <<'PY'
          import os
          import subprocess
          from datetime import datetime, timezone
          from urllib.parse import quote

          repo = os.environ["GH_REPOSITORY"]
          branch = os.environ["GH_BRANCH"]

          extensions = {
              ".html", ".htm", ".css", ".js", ".ts",
              ".jsx", ".tsx", ".py", ".java", ".c",
              ".cpp", ".h", ".hpp", ".cs", ".php",
              ".rb", ".go", ".rs", ".sql", ".json",
              ".xml", ".sh", ".yml", ".yaml"
          }

          files = subprocess.check_output(
              ["git", "ls-files", "-z"]
          ).decode().split("\0")

          entries = []

          for path in files:
              if not path or os.path.splitext(path)[1].lower() not in extensions:
                  continue

              # Ignore generated/dependency folders
              if any(part in {
                  "node_modules", ".git", "vendor",
                  "__pycache__", ".venv"
              } for part in path.split("/")):
                  continue

              result = subprocess.run(
                  ["git", "log", "-1", "--format=%ct", "--", path],
                  capture_output=True, text=True
              )

              if result.returncode != 0 or not result.stdout.strip():
                  continue

              timestamp = int(result.stdout.strip())
              date = datetime.fromtimestamp(
                  timestamp, timezone.utc
              ).strftime("%Y-%m-%d")

              url = (
                  f"https://github.com/{repo}/blob/"
                  f"{quote(branch, safe='')}/{quote(path, safe='/')}"
              )

              entries.append((timestamp, path, date, url))

          # Most recently updated files first
          entries.sort(key=lambda item: (-item[0], item[1].lower()))

          start = "<!-- CODE-LIST-START -->"
          end = "<!-- CODE-LIST-END -->"

          lines = [
              start,
              "## Senarai Kod Terkini",
              "",
              "> Disusun mengikut tarikh kemas kini terakhir, "
              "paling baharu di atas.",
              ""
          ]

          if entries:
              for _, path, date, url in entries:
                  lines.append(
                      f"- [{path}]({url}) — `{date}` (UTC)"
                  )
          else:
              lines.append("_Tiada fail kod dijumpai._")

          lines.extend(["", end])
          section = "\n".join(lines)

          readme = "README.md"
          content = ""

          if os.path.exists(readme):
              with open(readme, encoding="utf-8") as f:
                  content = f.read()

          if start in content and end in content:
              before = content.split(start, 1)[0]
              after = content.split(end, 1)[1]
              content = before + section + after
          else:
              content = content.rstrip() + "\n\n" + section + "\n"

          with open(readme, "w", encoding="utf-8") as f:
              f.write(content)
          PY

      - name: Commit updated list
        run: |
          git config user.name "github-actions[bot]"
          git config user.email \
            "41898282+github-actions[bot]@users.noreply.github.com"

          git add README.md

          if git diff --cached --quiet; then
            echo "Senarai kod sudah terkini."
            exit 0
          fi

          git commit -m "Update code list automatically"
          git push origin "HEAD:${{ github.ref_name }}"
```
